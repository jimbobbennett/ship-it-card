# Optional. Without it, cards get procedural art instead of Gemini art.
GEMINI_API_KEY=
# Optional. Raises the GitHub API rate limit from 60 to 5,000 requests an hour.
GITHUB_TOKEN=
# Optional. Override the Gemini image model.
SHIPIT_IMAGE_MODEL=gemini-2.5-flash-image
# Optional. Where /card.png keeps rendered cards on disk.
SHIPIT_CARD_CACHE_DIR=.cache/cards
# Optional. Token for GitHub Enterprise Server hosts (GITHUB_TOKEN is never sent there).
GHE_TOKEN=
# Optional. Comma-separated GHE hosts the web app may call. Unset rejects every host=.
SHIPIT_ALLOWED_HOSTS=
# Optional. Web app rate limit: cards per window per IP (0 disables), window in seconds,
# and the number of trusted reverse proxies in front of the app.
SHIPIT_RATE_LIMIT=30
SHIPIT_RATE_WINDOW=3600
SHIPIT_TRUSTED_PROXY_HOPS=0
